---
import { cardStr, parseCards, rankChar } from '../lib/poker/cards';

interface Props {
  /** e.g. "As Kd 7h" */
  c: string;
  /** Cards to fade out (e.g. not used in the winning hand). */
  dim?: string[];
  small?: boolean;
}
const { c, dim = [], small = false } = Astro.props;
const SYMBOL: Record<string, string> = { s: '♠', h: '♥', d: '♦', c: '♣' };
const SUIT_NAME: Record<string, string> = { s: 'spades', h: 'hearts', d: 'diamonds', c: 'clubs' };
const RANK_NAME: Record<string, string> = { A: 'Ace', K: 'King', Q: 'Queen', J: 'Jack', T: 'Ten' };
const cards = parseCards(c);
---

<span class:list={['cards', { small }]} role="img" aria-label={cards.map((x) => `${RANK_NAME[rankChar(x.rank)] ?? rankChar(x.rank)} of ${SUIT_NAME[x.suit]}`).join(', ')}>
  {
    cards.map((card) => {
      const r = rankChar(card.rank);
      return (
        <svg class:list={['card', { dim: dim.includes(cardStr(card)) }]} viewBox="0 0 42 58" aria-hidden="true">
          <rect x="1" y="1" width="40" height="56" rx="5" stroke-width="1.5" />
          <text x="5" y="22" class={`suit-${card.suit}`}>{r === 'T' ? '10' : r}</text>
          <text x="21" y="50" class={`suit-${card.suit}`} font-size="26" text-anchor="middle" style="font-size:26px">{SYMBOL[card.suit]}</text>
        </svg>
      );
    })
  }
</span>
